{
  "name": "@dsh-external/dsh-patch-keeper",
  "version": "0.2.1",
  "description": "补丁包管理（DSH 插件，hybrid）：把你在第三方插件/项目上的自定义修改提取为补丁包，官方更新时检测并提示，用 AI 把补丁合并到新版本（冲突自动交 AI 解决），再生成新补丁包。含 Web GUI 管理面板（设置「补丁包」分区，/patch-keeper/api）。纯 JS 零依赖。",
  "type": "module",
  "main": "./lib/main.js",
  "exports": {
    ".": "./lib/main.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frankiesondesu/dsh-patch-keeper.git"
  },
  "homepage": "https://github.com/Frankiesondesu/dsh-patch-keeper#readme",
  "bugs": {
    "url": "https://github.com/Frankiesondesu/dsh-patch-keeper/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "patch",
    "patch-keeper",
    "fork",
    "merge"
  ],
  "private": true
}
